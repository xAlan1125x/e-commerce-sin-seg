{
  "info": {
    "_postman_id": "788a7800-7d69-4a68-968d-ef83caf6f678",
    "name": "E-Commerce XP - Exposicion HTTP",
    "description": "Coleccion preparada para demostrar autenticacion JWT y los metodos POST, GET, PATCH y DELETE sobre la API del proyecto. Ejecutar las requests en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@estudio.local",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "Admin#12345",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productName",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 - Autenticacion",
      "item": [
        {
          "name": "POST - Iniciar sesion como ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "const respuesta = pm.response.json();",
                  "pm.test('Devuelve un JWT', () => pm.expect(respuesta.accessToken).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('accessToken', respuesta.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"deviceName\": \"Postman - Exposicion\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Autentica al administrador creado por el seed. El script guarda accessToken automaticamente para las siguientes requests."
          }
        }
      ]
    },
    {
      "name": "2 - CRUD de productos",
      "item": [
        {
          "name": "POST - Crear producto",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('productName', `Producto Demo ${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 Created', () => pm.response.to.have.status(201));",
                  "const producto = pm.response.json();",
                  "pm.test('El producto tiene ID', () => pm.expect(producto.id).to.exist);",
                  "pm.collectionVariables.set('productId', String(producto.id));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{productName}}\",\n  \"precio\": 25000,\n  \"stock\": 10,\n  \"categoria\": \"Demo Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "CREATE: crea un producto. Requiere JWT con rol ADMIN y guarda el ID recibido."
          }
        },
        {
          "name": "GET - Consultar catalogo filtrado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "const productos = pm.response.json();",
                  "pm.test('La respuesta es un arreglo', () => pm.expect(productos).to.be.an('array'));",
                  "pm.test('Contiene el producto creado', () => pm.expect(productos.some(p => String(p.id) === pm.collectionVariables.get('productId'))).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos?categoria=Demo%20Postman",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "Demo Postman"
                }
              ]
            },
            "description": "READ: consulta publica e idempotente. Muestra el uso de un query parameter para filtrar por categoria."
          }
        },
        {
          "name": "PATCH - Actualizar stock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('El stock quedo en 25', () => pm.expect(pm.response.json().stock).to.eql(25));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{productId}}/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "{{productId}}",
                "stock"
              ]
            },
            "description": "UPDATE parcial: cambia solo el stock del recurso identificado en la URL."
          }
        },
        {
          "name": "DELETE - Eliminar producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('La respuesta no tiene body', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "{{productId}}"
              ]
            },
            "description": "DELETE: elimina el producto creado. Un 204 exitoso no devuelve contenido."
          }
        }
      ]
    },
    {
      "name": "3 - Errores opcionales",
      "item": [
        {
          "name": "POST - Sin token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Intento sin autorizacion\",\n  \"precio\": 1000,\n  \"stock\": 1,\n  \"categoria\": \"Demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "Demuestra que escribir en el catalogo exige autenticacion."
          }
        },
        {
          "name": "PATCH - Stock negativo (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 422 Unprocessable Content', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": -5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{productId}}/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "{{productId}}",
                "stock"
              ]
            },
            "description": "Demuestra una regla de negocio: el stock no puede ser negativo. La validacion ocurre antes de buscar el producto."
          }
        }
      ]
    }
  ]
}
